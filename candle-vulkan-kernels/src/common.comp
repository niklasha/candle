#ifndef COMMON_COMP_GUARD
  #define COMMON_COMP_GUARD

  #extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable
  #extension GL_EXT_shader_atomic_float : enable

  #if FLOAT32_ATOMIC_ADD
    #define ATOMIC_FLOAT32 float
    #define ATOMIC_ADD(sum, term) atomicAdd((sum), (term))
  #else
    #define ATOMIC_FLOAT32 uint
    // Emulate atomicAdd with a CAS loop.
    // "sum" needs to be an lhs without side-effects
    #define ATOMIC_ADD(sum, term) {                                             \
        uint oldBits = atomicCompSwap((sum), 0, 0);                             \
        float oldVal = uintBitsToFloat(oldBits);                                \
        float addVal = (term);                                                  \
        float newVal;                                                           \
        while (true) {                                                          \
            newVal = oldVal + addVal;                                           \
            uint newBits = floatBitsToUint(newVal);                             \
            uint prevBits = atomicCompSwap((sum), oldBits, newBits);            \
            if (prevBits == oldBits) {                                          \
                break;                                                          \
            }                                                                   \
            oldBits = prevBits;                                                 \
            oldVal = uintBitsToFloat(oldBits);                                  \
        }                                                                       \
    }
  #endif

uint global_linear_id() {
    uvec3 gid = gl_GlobalInvocationID;
    uvec3 num_groups = gl_NumWorkGroups;
    uvec3 group_size = gl_WorkGroupSize;

    uint groups_per_row = num_groups.x;
    uint groups_per_plane = num_groups.x * num_groups.y;

    return gid.x
        + gid.y * group_size.x * groups_per_row
        + gid.z * group_size.x * groups_per_plane;
}

#endif

